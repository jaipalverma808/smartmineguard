# SmartMineGuard - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN REAL VALUES FOR LOCAL/PRODUCTION USAGE
# NEVER COMMIT REAL PASSWORDS OR PRIVATE KEYS TO VERSION CONTROL

# Flask Session Security Key (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-secure-random-64-character-secret-key

# Operational Environment & SIH Demonstration Mode
ENVIRONMENT=development
DEMO_MODE=true

# Administrative & Statutory Accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_NAME=Sanjay Verma, IAS
ADMIN_EMAIL=sanjay.verma@mines.gov.in

OFFICER_USERNAME=officer1
OFFICER_PASSWORD=replace_with_strong_officer_password
OFFICER_NAME=Inspector Rajesh K. Meena
OFFICER_EMAIL=rajesh.meena@enforcement.gov.in

OPERATOR_USERNAME=operator1
OPERATOR_PASSWORD=replace_with_strong_operator_password
OPERATOR_NAME=Virendra Singh Rathore
OPERATOR_EMAIL=virendra@aravalliminerals.com

# Database Connection (PostgreSQL with PostGIS for production, or USE_SQLITE=true for local development)
USE_SQLITE=true
# DATABASE_URL=postgresql://username:password@host:5432/smartmineguard
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=smartmineguard
# DB_USER=postgres
# DB_PASSWORD=your_db_password

# Server Settings
PORT=5000
DEBUG=true
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=28800

# Detection & Risk Parameter Thresholds
WEIGHT_TOLERANCE_PERCENT=5.0
ROUTE_CORRIDOR_METERS=350
GPS_BLACKOUT_SECONDS=60
MAX_REASONABLE_SPEED_KMH=85
